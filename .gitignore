# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Build artifacts
build/
dist/
*.spec

# Runtime files
logs/
*.log

# Network captures (DevTools HAR exports). These record full request and
# response headers, so they routinely carry access_key values and cookies.
*.har

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Copilot
AGENTS.md

# Project specific
help.md

# Credentials. `config.json` holds Bilibili access_keys, and the exact-name
# rule let a hand-made copy ("config copy.json") sit untracked-but-committable.
# Match the whole family instead.
config*.json
