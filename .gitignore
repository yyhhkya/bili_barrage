# Runtime files
*.log

# Network captures (DevTools HAR exports). These record full request and
# response headers, so they routinely carry access_key values and cookies.
*.har

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Credentials. The app's config.json holds Bilibili access_keys, and this used
# to be an exact-name rule — which let a hand-made copy ("config copy.json")
# sit untracked-but-committable. Match the whole family instead.
config*.json
